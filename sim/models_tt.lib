* SKY130 1.8 V transistor models, tt corner.
* Only the two devices used by the cells are loaded, which keeps
* ngspice start-up short. Dimensions are in micrometres (scale=1u).
.option scale=1.0u
.param mc_mm_switch=0
.param mc_pr_switch=0
.param sky130_fd_pr__nfet_01v8__dlc_rotweak=0
.param sky130_fd_pr__pfet_01v8_hvt__dlc_rotweak=0
.include "../pdk/fd_pr/models/parameters/lod.spice"
.include "../pdk/fd_pr/models/parameters/invariant.spice"
.include "../pdk/fd_pr/cells/nfet_01v8/sky130_fd_pr__nfet_01v8__tt.corner.spice"
.include "../pdk/fd_pr/cells/nfet_01v8/sky130_fd_pr__nfet_01v8__mismatch.corner.spice"
.include "../pdk/fd_pr/cells/pfet_01v8_hvt/sky130_fd_pr__pfet_01v8_hvt__tt.corner.spice"
.include "../pdk/fd_pr/cells/pfet_01v8_hvt/sky130_fd_pr__pfet_01v8_hvt__mismatch.corner.spice"
